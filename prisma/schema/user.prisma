model User {
  id String @id @default(cuid())

  email        String @unique
  passwordHash String @map("password_hash")

  emailVerified Boolean @default(false) @map("email_verified")

  username String  @unique
  avatar   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wishlists              Wishlist[]
  emailVerificationToken EmailVerificationToken[]
  refreshToken           RefreshToken[]
  reservedItems          WishlistItem[]           @relation("ItemReserver")

  sentFriendRequests     FriendRequest[] @relation("FriendRequester")
  receivedFriendRequests FriendRequest[] @relation("FriendAddressee")

  friendshipsInitiated Friend[] @relation("FriendUser1")
  friendshipsReceived  Friend[] @relation("FriendUser2")

  @@map("users")
}
